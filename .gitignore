# -----------------------------------------------------------
# .gitignore für das Projekt "sciencemodels"
# (ursprünglich angelegt für "ifso_plan", April 2025)
#
# Hinweis:
# Diese .gitignore selbst wird im Git-Repository mitgeführt
# und sorgt dafür, dass bestimmte Dateien erst gar nicht
# versioniert werden.
# -----------------------------------------------------------



# 🐍 Virtuelle Umgebungen (lokale Python-Installationen)
venv/
ifsoC/
.venv/
pyrightconfig.json
ruff.toml

# 🐍 Automatisch erzeugte Python-Cache-Dateien
__pycache__/
data/*
*.py[cod]

# 📓 Jupyter Notebook Checkpoints (Zwischenspeicher)
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# 🍏 MacOS Finder Dateien (werden auf Macs gerne automatisch erzeugt)
.DS_Store

# 🛠️ VS Code & PyCharm Projektordner (lokale IDE-Einstellungen)
.vscode/
.idea/

# 🧪 Test- und Debug-Reste
.pytest_cache/
*.log

# 📊 Automatisch erzeugte Daten- und Ergebnisdateien (Plots, Exporte etc.)
*.csv
*.xlsx
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# -----------------------------------------------------------
# Ausnahme (owner ruling 2026-11-23): Publikationsfiguren als
# PNG werden versioniert, damit die Markdown-Dokumente (Paper,
# Reports, CONT-Einträge) auf jedem System die Bilder zeigen.
# Zahlen (CSV) bleiben generiert und ignoriert.
# -----------------------------------------------------------
!output/report_notebook_v1/*.png
data/*
!data/*/
data/*/*
!data/*/figures/
!data/*/figures/*.png

# -----------------------------------------------------------
# PDF-Ausnahme (owner ruling 2026-11-23): Figure-PDFs (Vektor-
# kompanions der getrackten PNGs) und die kompilierten PDFs
# getrackter Markdown-Dokumente werden versioniert. NICHT
# versioniert: der Literaturkorpus in context/ (Drittanbieter-
# Verlags-PDFs, Urheberrecht) und alles andere Generierte.
# -----------------------------------------------------------
!output/report_notebook_v1/*.pdf
!data/*/figures/*.pdf
!AdmiralsLog/*.pdf
!AdmiralsLog/*/*.pdf
!docs/*.pdf
!drafts/*.pdf
!drafts/archive/*.pdf
!output/reports/*.pdf
